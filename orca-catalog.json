{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-catalog.v2.schema.json",
  "catalogVersion": 2,
  "name": "Nithin's Orca plugins",
  "owner": "NithinPaul1360",
  "plugins": [
    {
      "id": "nithinpaul1360.tmux-subagent-viewer",
