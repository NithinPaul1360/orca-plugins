          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Tmux Subagent Viewer",
          "contributes": [
            {
              "kind": "panels",
              "name": "Tmux Subagent Viewer"
            }
          ],
          "capabilities": [
            "workspace:read",
            "terminal:read"
          ],
          "images": {
